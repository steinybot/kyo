runner.dialect = scala213
maxColumn = 40
rewrite.rules = [AvoidInfix]
rewrite.avoidInfix.excludePlaceholderArg = false
<<< example
_ foo _
_ bar (_: Int)
_ baz (_.qux)
_ baz _.qux // cannot be rewritten, not the same as previous line
>>>
_.foo(_)
_.bar(_: Int)
_.baz(_.qux)
_ baz _.qux // cannot be rewritten, not the same as previous line
