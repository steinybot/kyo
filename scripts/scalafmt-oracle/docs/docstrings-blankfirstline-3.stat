runner.dialect = scala213
maxColumn = 40
# preserve a blank first line
docstrings.blankFirstLine = keep
docstrings.style = SpaceAsterisk
maxColumn = 30
<<< example
/** Scaladoc oneline */
/** Scaladoc multiline1
  */
/**
  * Scaladoc multiline2
  */
val a = 1
>>>
/** Scaladoc oneline */
/** Scaladoc multiline1
  */
/** Scaladoc multiline2
  */
val a = 1
