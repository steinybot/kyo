runner.dialect = scala213
maxColumn = 40
binPack.parentConstructors = Oneline
maxColumn = 30
<<< example
object A {
  class Foo(a: Int)
  extends Bar
  with Baz

  class Foo(
    a: Int
  )
  extends Bar
  with Baz
}
>>>
object A {
  class Foo(a: Int)
      extends Bar with Baz

  class Foo(
      a: Int
  ) extends Bar with Baz
}
