  }
}
>>>
// all disabled, no breaks
class A {
  def foo = func(
    foo,
    bar
  )
  val foo = func(
    foo,
    bar
  )
  def foo = {
    def a = func(
      foo,
      bar
    )
    val a = func(
      foo,
      bar
    )
  }
}
